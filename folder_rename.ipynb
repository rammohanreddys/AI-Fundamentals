import os

# 1. Set the directory path where your folders are located
parent_directory = r"./test"

# 2. Loop through everything inside that directory
for item_name in os.listdir(parent_directory):
    full_path = os.path.join(parent_directory, item_name)
    
    # Check if it's a folder and if it starts with 'svc '
    if os.path.isdir(full_path) and item_name.startswith("svc "):
        
        # 3. Remove 'svc ' to leave only the number (e.g., "svc 123" -> "123")
        new_name = item_name.replace("svc ", "")
        
        # Create the full path for the renamed folder
        new_full_path = os.path.join(parent_directory, new_name)
        
        # 4. Rename the folder
        os.rename(full_path, new_full_path)
        print(f"Renamed: '{item_name}' ---> '{new_name}'")
